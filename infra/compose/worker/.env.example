# Identity and model artifact for this specific Worker VM.
CC_WORKER_ID=node1
CC_MODEL_KEY=models/node1/current.onnx

# Redis on NodeMaster. Keep the password URL-safe: letters, digits, "_", and "-".
CC_REDIS_URL=redis://:cc-lab@192.168.4.168:6379/0
CC_HEARTBEAT_TTL_SECONDS=15
CC_HEARTBEAT_INTERVAL_SECONDS=5
CC_CONSUMER_GROUP_NAME=cc-workers
CC_STREAM_BLOCK_MS=1000
CC_PENDING_JOB_RECLAIM_IDLE_MS=60000
CC_RESULT_TTL_SECONDS=300

# RustFS on NodeMaster.
CC_RUSTFS_ENDPOINT_URL=http://192.168.4.168:9000
CC_RUSTFS_ACCESS_KEY=cc-lab
CC_RUSTFS_SECRET_KEY=cc-lab
CC_RUSTFS_REGION=tw-taipei-1
CC_RUSTFS_BUCKET=cc-lab
