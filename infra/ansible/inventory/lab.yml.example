---
all:
    vars:
        lab_jump_host: physical_host_ip
        lab_jump_user: physical_host_username

    children:
        cloudstack_hosts:
            hosts:
                physical_hosts:
                    ansible_host: physical_host_ip
                    ansible_user: physical_host_username

            guest_nodes:
                children:
                    master_nodes:
                        hosts:
                            nodemaster:
                                ansible_host: nodemaster_ip
                                ansible_user: nodemaster_username

                    worker_nodes:
                        hosts:
                            node1:
                                ansible_host: node1_ip
                                ansible_user: node1_username

                            node2:
                                ansible_host: node2_ip
                                ansible_user: node2_username
