# Service
CC_MASTER_NAME=cc-master
CC_MASTER_HOST=0.0.0.0
CC_MASTER_PORT=8000

# Redis runtime coordinator
CC_REDIS_URL=redis://localhost:6379/0
CC_WORKER_IDS_CSV=node1,node2
CC_WORKER_RESERVATION_TTL_SECONDS=30
CC_JOB_TTL_SECONDS=300

# RustFS object storage (S3-compatible API)
CC_RUSTFS_ENDPOINT_URL=http://localhost:9000
CC_RUSTFS_ACCESS_KEY=replace-me
CC_RUSTFS_SECRET_KEY=replace-me
CC_RUSTFS_REGION=ap-east-1
CC_RUSTFS_BUCKET=cc-lab
