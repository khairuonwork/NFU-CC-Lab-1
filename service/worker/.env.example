# Identity: Node1 and Node2 run the same worker image with distinct values.
CC_WORKER_ID=node1

# Redis runtime coordinator
CC_REDIS_URL=redis://localhost:6379/0

# The master considers this worker offline after this TTL expires.
CC_HEARTBEAT_TTL_SECONDS=15
CC_HEARTBEAT_INTERVAL_SECONDS=5

# Redis Stream delivery and temporary result retention
CC_CONSUMER_GROUP_NAME=cc-workers
CC_STREAM_BLOCK_MS=1000
CC_PENDING_JOB_RECLAIM_IDLE_MS=60000
CC_RESULT_TTL_SECONDS=300

# RustFS object storage (S3-compatible API)
CC_RUSTFS_ENDPOINT_URL=http://localhost:9000
CC_RUSTFS_ACCESS_KEY=replace-me
CC_RUSTFS_SECRET_KEY=replace-me
CC_RUSTFS_REGION=tw-taipei-1
CC_RUSTFS_BUCKET=cc-lab

# This directory is safe to clear because it stores only temporary input images.
CC_WORKER_CACHE_DIR=/tmp/cc-worker-cache

# Both workers download the same ONNX object and keep separate local caches.
CC_MODEL_KEY=models/baseline-mobilenetv3-small.onnx
CC_MODEL_CACHE_DIR=/tmp/cc-worker-model-cache
